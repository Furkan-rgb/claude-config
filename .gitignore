# Track only hand-maintained config; everything else is runtime state.
/*
!/.gitignore
!/CLAUDE.md
!/README.md
!/test
!/tests/
!/.githooks/
!/settings.json
!/statusline.py
!/themes/
!/agents/
!/skills/
/skills/*
!/skills/lead-playbook/
!/skills/task-ledger/
__pycache__/
!/mods/
# Written by the engine on load; regenerated per build.
/mods/*/.claude-plugin/types/
