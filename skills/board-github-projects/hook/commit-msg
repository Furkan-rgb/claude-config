#!/usr/bin/env bash
# Refuse a commit whose message does not cite the board item it lands.
#
# `git` hands this hook the message file, already assembled, whatever produced it -- `-m`, `-F`,
# an editor, a merge, a revert, a cherry-pick, a rebase. That is the whole reason it lives here
# rather than in a PreToolUse hook that had to reconstruct the message by parsing a shell command
# string: every trick used to hide a message from that parser (`-qm`, a pooled heredoc, `<<<`,
# a second commit later in the chain) is invisible here, because there is nothing left to parse.
# `git merge` is gated too, and that is the point: a merge is a landing, and a landing is exactly
# what the board wants to hear about.
#
# Measured on git 2.x in a fixture repository, because it is not what the hook's name suggests:
# `git commit` and `git merge` invoke this hook; `git cherry-pick`, `git revert` and `git rebase`
# do NOT -- the sequencer writes those commits without it. So a reverted or cherry-picked commit
# carries whatever trailer it inherited and is never checked. Not a hole worth plugging here: the
# branch it lands on is merged, and the merge is gated.
#
# Exempt: branches named `wip/*`. Scratch history, rebased before it lands.
#
# Fails OPEN on infrastructure -- no gh, no auth, offline, empty board -- with one line on
# stderr. It fails CLOSED only on a missing trailer, which needs no network, and on an answer the
# board actually gave. A guard that blocks correct work when the network is down gets switched
# off, and then the rule stops executing entirely.
#
# bash + jq only.
set -u

OWNER="<owner>"
PROJECT="<N>"
REPO_URL="$(git remote get-url origin 2>/dev/null)"
REPO_URL="${REPO_URL%.git}"
REPO_SLUG="${REPO_URL##*github.com[:/]}"
REPO_NAME="${REPO_SLUG#*/}"

REFUSAL='Commit refused: no `Refs #n` / `Closes #n` trailer. Cite the board item this lands (must be In Progress). Draft items are converted to issues at dispatch — see AGENTS.md and board-github-projects SKILL.md, Create.'

msg_file=${1:-}
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

skip() { printf 'board gate skipped: gh unavailable (%s)\n' "$1" >&2; exit 0; }
refuse() { printf '%s\n' "$1" >&2; exit 1; }

# A single item's status, re-checked rather than trusted from the copy already read -- the
# cache can lag or omit a just-added item for reasons that have nothing to do with that item's
# actual status. `$cache` (the board-cache.sh path) must already be resolved before this is
# called. Prints the status name on stdout when the issue is found on this project; prints
# nothing when it genuinely is not; returns 2 only when every lookup attempted failed
# (gh/network), the one case this must fail open on.
#
# Two tries, cheapest first: a forced REST cache refresh (board-cache.sh --force), then --
# only if that still does not have the item -- a direct per-issue GraphQL traversal. Measured
# 2026-09-24: the REST *list* endpoint (which the forced refresh re-runs) can lag a write by
# minutes, same as GraphQL's `items` connection did before this hook moved to REST; a *direct*
# GraphQL fetch by issue number (not through any list) stayed fresh throughout. So the REST
# refresh is normally enough and costs nothing extra when it is; the GraphQL fallback exists
# for the specific gap the list-based refresh cannot close on its own.
direct_status() {
    local n="$1" fresh rc out status
    fresh="$("$cache" --force 2>/dev/null)"; rc=$?
    if [ "$rc" = "0" ]; then
        status="$(printf '%s' "$fresh" | jq -r --argjson n "$n" \
            '[.items[] | select(.content.number == $n)][0].status // ""' 2>/dev/null)"
        [ -n "$status" ] && { printf '%s' "$status"; return 0; }
    fi
    [ -n "$REPO_NAME" ] || { [ "$rc" = "0" ] && return 0 || return 2; }
    out="$(timeout 8 gh api graphql -f query='
      query($owner:String!, $repo:String!, $number:Int!) {
        repository(owner:$owner, name:$repo) {
          issue(number:$number) {
            projectItems(first: 20) {
              nodes {
                project { number }
                fieldValueByName(name: "Status") {
                  ... on ProjectV2ItemFieldSingleSelectValue { name }
                }
              }
            }
          }
        }
      }' -f owner="$OWNER" -f repo="$REPO_NAME" -F number="$n" 2>/dev/null)"
    grc=$?
    if [ "$grc" != "0" ] || [ -z "$out" ]; then
        [ "$rc" = "0" ] && return 0 || return 2
    fi
    printf '%s' "$out" | jq -r --argjson p "$PROJECT" \
        '.data.repository.issue.projectItems.nodes[]? | select(.project.number == $p) | (.fieldValueByName.name // "")' 2>/dev/null
}

# ── scratch branches are exempt ───────────────────────────────────────────────────────────────
# `symbolic-ref` answers on an unborn branch, where `rev-parse HEAD` fails for want of a commit;
# `rev-parse` is the fallback for a detached HEAD, where `symbolic-ref` is the one that fails.
branch="$(git symbolic-ref --short -q HEAD 2>/dev/null)" \
    || branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" \
    || branch=""
case $branch in
    wip/*) exit 0 ;;
esac

# ── the trailer ───────────────────────────────────────────────────────────────────────────────
# Comment lines are git's scaffolding, not the author's message: a `# Refs #4` left in the
# template must not satisfy the gate, and a `#` line quoting a diff must not be scanned.
#
# `|| [ -n "$line" ]` is load-bearing, not defensive. Git writes `.git/MERGE_MSG` with no
# trailing newline, so a plain `while read` drops its last line -- and the last line is where a
# trailer lives. Without it every `git merge -m "... Refs #n"` was refused for having no trailer,
# which is precisely the commit, a landing, that the board most needs to hear about.
cited=()
while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case $line in \#*) continue ;; esac
    [[ $line =~ ^(Refs|Closes)\ #[0-9]+ ]] || continue
    # Every number on a trailer line is cited, so `Closes #1, #2` gates on both.
    rest=$line
    while [[ $rest =~ \#([0-9]+) ]]; do
        cited+=("${BASH_REMATCH[1]}")
        rest=${rest#*"#${BASH_REMATCH[1]}"}
    done
done < "$msg_file"

[ ${#cited[@]} -gt 0 ] || refuse "$REFUSAL"

# ── the board's answer ────────────────────────────────────────────────────────────────────────
# Hooks are shared via the common git dir, so a linked worktree's `$0` is still
# <common-dir>/hooks/commit-msg -- but `--show-toplevel` there answers with the *worktree's* own
# path, not the main checkout's, and board-cache.sh (untracked) lives only in the main checkout.
# `--git-common-dir` is worktree-invariant, so try its parent first; fall back to the current
# worktree's own toplevel for a layout where the cache script is placed there deliberately.
hook_dir="$(cd "$(dirname "$0")" && pwd)"
cache="$hook_dir/../.claude/hooks/board-cache.sh"
if ! [ -x "$cache" ]; then
    common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || common_dir=""
    main_top=""
    [ -n "$common_dir" ] && main_top="$(cd "$common_dir/.." && pwd 2>/dev/null)"
    [ -n "$main_top" ] && cache="$main_top/.claude/hooks/board-cache.sh"
fi
if ! [ -x "$cache" ]; then
    top="$(git rev-parse --show-toplevel 2>/dev/null)" || top=""
    cache="$top/.claude/hooks/board-cache.sh"
fi
[ -x "$cache" ] || skip "board-cache.sh not found"
command -v jq >/dev/null 2>&1 || skip "jq not installed"

# Exit 3 means the JSON is the last good copy, not a fresh one. See board-cache.sh's contract.
items="$("$cache" 2>/dev/null)"; rc=$?
stale=0
case $rc in
    0) ;;
    3) stale=1 ;;
    *) skip "board unreachable and no cache" ;;
esac
count="$(printf '%s' "$items" | jq -r '.items | length' 2>/dev/null)" || skip "board output not understood"
[ -n "$count" ] && [ "$count" != "null" ] || skip "board output not understood"

# An empty board is indistinguishable from a board we failed to read, and refusing every commit
# because a query came back empty is the "fails closed on infrastructure" mistake.
[ "$count" -gt 0 ] 2>/dev/null || skip "empty item list"

seen=" "
for n in "${cited[@]}"; do
    case $seen in *" $n "*) continue ;; esac
    seen+="$n "
    status="$(printf '%s' "$items" | jq -r --argjson n "$n" \
        '[.items[] | select(.content.number == $n)][0].status // ""' 2>/dev/null)"
    if [ -z "$status" ]; then
        # The list-fetch's absence proves nothing on its own -- ask about this one item
        # directly instead of trusting the full list's timing (staleness or an omission it
        # cannot otherwise explain). Fail open only when that direct lookup itself fails.
        direct="$(direct_status "$n")"; drc=$?
        if [ "$drc" = "2" ]; then
            skip "board data does not have #$n and the direct lookup failed"
        fi
        status="$direct"
    fi
    if [ -z "$status" ]; then
        refuse "Commit refused: #$n is not on the board (project $PROJECT, $OWNER). Cite the item this commit lands, or add it to the board first — see board-github-projects SKILL.md, Create."
    fi
    status_lc="$(printf '%s' "$status" | tr '[:upper:]' '[:lower:]')"
    if [ "$status_lc" != "in progress" ]; then
        refuse "Commit refused: board item #$n has status '$status', not 'In Progress'. Dispatch sets an item In Progress in the packet that starts the work; a commit landing against a '$status' item means the board and the tree disagree. Move it, or cite the item that is actually in flight."
    fi
done

exit 0
