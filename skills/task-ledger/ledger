#!/usr/bin/env python3
"""task-ledger: one command set for a project's task board, whatever the backend.

The project chooses its backend once, in `.ledger/config.json` at the project root:

    {"backend": "local"}
    {"backend": "github", "owner": "<login>", "project": <N>, "repo": "<owner>/<repo>"}

Items are addressed by number: the local id, or the GitHub issue number. A GitHub card with no
issue behind it (a draft) is addressed as `draft:<item id>` and becomes an issue when it moves to
In progress, because commits cite issue numbers.

Milestones group items; within a milestone the items with no parent are its exits and their
sub-items are its tasks. Progress is computed from item states, never stored.
"""
import argparse
import fcntl
import hashlib
import json
import os
import re
import select
import shlex
import signal
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

STATUSES = ["Backlog", "Next", "In progress", "Blocked", "Done"]
OPEN_ORDER = {"in progress": 0, "next": 1, "blocked": 2, "backlog": 3}
BRIEF_STATUSES = ("in progress", "next", "blocked")
RECONCILE = "Board: update any item you start, finish, block, or learn something about in this turn."
CACHE_SECONDS = 60


class LedgerError(Exception):
    pass


def canonical_status(name):
    for s in STATUSES:
        if s.lower() == name.strip().lower():
            return s
    raise LedgerError(f"unknown status {name!r}; use one of: {', '.join(STATUSES)}")


def project_root():
    env = os.environ.get("CLAUDE_PROJECT_DIR")
    start = Path(env) if env else Path.cwd()
    for d in [start, *start.parents]:
        if (d / ".ledger" / "config.json").is_file():
            return d
    return None


def private_dir():
    base = os.environ.get("XDG_RUNTIME_DIR")
    d = Path(base) / "task-ledger" if base and os.path.isdir(base) else Path.home() / ".cache" / "task-ledger"
    d.mkdir(mode=0o700, parents=True, exist_ok=True)
    return d


# ── local backend ────────────────────────────────────────────────────────────────────────────

class LocalBackend:
    def __init__(self, root, config):
        self.path = root / ".ledger" / "ledger.json"

    def _load(self):
        if not self.path.is_file():
            raise LedgerError(f"{self.path} missing; run `ledger init local`")
        return json.loads(self.path.read_text())

    def _save(self, data):
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(data, indent=2) + "\n")
        tmp.replace(self.path)

    def _find(self, data, ref):
        for it in data["items"]:
            if str(it["id"]) == str(ref).lstrip("#"):
                return it
        raise LedgerError(f"no item #{ref}")

    def items(self):
        return [{"ref": str(it["id"]), "number": it["id"], "title": it["title"], "status": it["status"]}
                for it in self._load()["items"]]

    def show(self, ref):
        return self._find(self._load(), ref)

    def create(self, title, body, status):
        data = self._load()
        item = {"id": data["next_id"], "title": title, "body": body, "status": status, "comments": []}
        data["next_id"] += 1
        data["items"].append(item)
        self._save(data)
        return str(item["id"])

    def move(self, ref, status):
        data = self._load()
        self._find(data, ref)["status"] = status
        self._save(data)
        return ref

    def comment(self, ref, text):
        data = self._load()
        self._find(data, ref)["comments"].append({"at": time.strftime("%Y-%m-%d %H:%M"), "text": text})
        self._save(data)

    def close(self, ref):
        data = self._load()
        item = self._find(data, ref)
        item["status"], item["closed_at"] = "Done", datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")
        self._save(data)

    def recently_closed(self):
        return [{"ref": str(it["id"]), "title": it["title"], "closed_at": it["closed_at"],
                 "exit": "milestone" in it and "parent" not in it}
                for it in self._load()["items"] if it["status"] == "Done" and it.get("closed_at")]

    def status_of(self, ref):
        return self._find(self._load(), ref)["status"]

    # Milestones and parents: `milestones` is an optional top-level list of {title, description};
    # an item carries optional `milestone` (a title) and `parent` (an item id).

    def milestones(self):
        data = self._load()
        rows = []
        for m in data.get("milestones", []):
            mine = [it for it in data["items"] if it.get("milestone") == m["title"]]
            closed = sum(1 for it in mine if it["status"] == "Done")
            rows.append({"title": m["title"], "state": "open", "open": len(mine) - closed, "closed": closed, "due": None})
        return rows

    def create_milestone(self, title, description):
        data = self._load()
        if any(m["title"] == title for m in data.get("milestones", [])):
            raise LedgerError(f"milestone {title!r} already exists")
        data.setdefault("milestones", []).append({"title": title, "description": description})
        self._save(data)

    def set_milestone(self, ref, title):
        data = self._load()
        self._find(data, ref)["milestone"] = title
        self._save(data)
        return ref

    def milestone_of(self, ref):
        return self._find(self._load(), ref).get("milestone")

    def rename_milestone(self, old, new):
        data = self._load()
        if any(m["title"] == new for m in data.get("milestones", [])):
            raise LedgerError(f"milestone {new!r} already exists")
        next(m for m in data["milestones"] if m["title"] == old)["title"] = new
        for it in data["items"]:
            if it.get("milestone") == old:
                it["milestone"] = new
        self._save(data)

    def unplaced(self, refs):
        """The refs whose items have neither a milestone nor a parent."""
        data = self._load()
        return [r for r in refs if not ({"milestone", "parent"} & self._find(data, r).keys())]

    def set_parent(self, child, parent, dry_run):
        data = self._load()
        item, up = self._find(data, child), self._find(data, parent)
        ancestor = up
        while ancestor is not None:
            if ancestor is item:
                raise LedgerError(f"#{up['id']} is #{item['id']} or below it; that would make a cycle")
            ancestor = self._find(data, ancestor["parent"]) if "parent" in ancestor else None
        if dry_run:
            print(f"dry-run: set parent of #{item['id']} to #{up['id']} in {self.path}")
            return child
        item["parent"] = up["id"]
        self._save(data)
        return child

    def unparent(self, child, dry_run):
        data = self._load()
        item = self._find(data, child)
        if "parent" not in item:
            raise LedgerError(f"#{item['id']} has no parent")
        if dry_run:
            print(f"dry-run: remove parent #{item['parent']} from #{item['id']} in {self.path}")
            return child
        del item["parent"]
        self._save(data)
        return child

    def parent_of(self, ref):
        p = self._find(self._load(), ref).get("parent")
        return str(p) if p is not None else None

    def outline(self, children):
        data = self._load()
        node = lambda it: {"ref": str(it["id"]), "title": it["title"], "done": it["status"] == "Done"}
        result = []
        for m in data.get("milestones", []):
            exits = []
            for it in data["items"]:
                if it.get("milestone") == m["title"] and it.get("parent") is None:
                    kids = [node(k) for k in data["items"] if k.get("parent") == it["id"]]
                    exits.append({**node(it), "child_done": sum(k["done"] for k in kids), "child_total": len(kids),
                                  "children": kids if children else None})
            result.append({"title": m["title"], "state": "open", "exits": exits})
        return result

    @staticmethod
    def init(root, args):
        path = root / ".ledger" / "ledger.json"
        if not path.exists():
            path.write_text(json.dumps({"next_id": 1, "items": []}, indent=2) + "\n")
        return {"backend": "local"}


# ── GitHub Projects v2 backend ───────────────────────────────────────────────────────────────
# Reads and board writes go over REST: GraphQL has its own points bucket, observed pinned for
# hours under concurrent agent load while REST on the same token kept working. Reads share a
# 60-second per-user cache, so the per-turn hook and a commit gate cost one API call per minute
# rather than one each, which avoids GitHub's secondary rate limit.

class GitHubBackend:
    API = ["-H", "X-GitHub-Api-Version: 2022-11-28"]

    def __init__(self, root, config):
        try:
            self.owner, self.number, self.repo = config["owner"], int(config["project"]), config["repo"]
        except KeyError as e:
            raise LedgerError(f".ledger/config.json lacks {e}")
        self.kind = config.get("owner_type", "users")
        self.base = f"/{self.kind}/{self.owner}/projectsV2/{self.number}"
        self.cache = private_dir() / f"github-{self.owner}-{self.number}.json"
        self.closed_cache = private_dir() / f"closed-{self.owner}-{self.number}.json"

    def _gh(self, *args, timeout=20):
        # Its own process group, killed whole on timeout: subprocess.run kills only gh and then
        # waits for its output pipes, which anything gh started can hold open indefinitely.
        proc = subprocess.Popen(["gh", *args], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True, start_new_session=True)
        try:
            out, err = proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, signal.SIGKILL)
            proc.communicate()
            raise
        if proc.returncode != 0:
            raise LedgerError(f"gh {' '.join(args[:3])}: {err.strip() or out.strip()}")
        return out

    def _api(self, path, *extra, paginate=False):
        args = ["api", path, *self.API, *extra] + (["--paginate"] if paginate else [])
        out = self._gh(*args)
        if paginate:  # --paginate concatenates one JSON array per page
            dec, pos, merged = json.JSONDecoder(), 0, []
            out = out.strip()
            while pos < len(out):
                chunk, pos = dec.raw_decode(out, pos)
                merged.extend(chunk)
                while pos < len(out) and out[pos].isspace():
                    pos += 1
            return merged
        return json.loads(out) if out.strip() else None

    def _fetch(self):
        fields = self._api(f"{self.base}/fields", paginate=True)
        status = next((f for f in fields if f.get("name") == "Status"), None)
        if not status:
            raise LedgerError("project has no Status field")
        raw = self._api(f"{self.base}/items?fields[]={status['id']}&per_page=100", paginate=True)
        items = []
        for it in raw:
            content = it.get("content") or {}
            value = next((f.get("value") for f in it.get("fields", []) if f.get("name") == "Status"), None)
            items.append({
                "status": (value or {}).get("name", {}).get("raw") if value else None,
                "content": {"number": content.get("number"), "title": content.get("title")} if content else None,
                "title": content.get("title") or it.get("title"),
                "project_item_id": it["id"],
                "node_id": it.get("node_id"),
            })
        return {"status_field_id": status["id"], "status_options": status.get("options", []), "items": items}

    def board(self, force=False):
        """The board JSON and whether it is fresh. Falls back to the last good copy when a
        refresh fails, and says so: a stale copy can be trusted for a status, not an absence."""
        if not force and self.cache.is_file() and time.time() - self.cache.stat().st_mtime < CACHE_SECONDS:
            return json.loads(self.cache.read_text()), True
        try:
            data = self._fetch()
        except (LedgerError, subprocess.TimeoutExpired, FileNotFoundError, ValueError) as e:
            if self.cache.is_file():
                return json.loads(self.cache.read_text()), False
            raise LedgerError(f"board unreachable: {e}")
        tmp = self.cache.with_suffix(".tmp")
        tmp.write_text(json.dumps(data))
        tmp.replace(self.cache)
        return data, True

    def items(self):
        out = []
        for it in self.board()[0]["items"]:
            n = (it.get("content") or {}).get("number")
            ref = str(n) if n is not None else f"draft:{it['project_item_id']}"
            out.append({"ref": ref, "number": n, "title": it.get("title") or "", "status": it.get("status") or "Backlog"})
        return out

    def _item(self, ref, board=None):
        board = board or self.board()[0]
        ref = str(ref).lstrip("#")
        for it in board["items"]:
            n = (it.get("content") or {}).get("number")
            if (ref.startswith("draft:") and ref[6:] == str(it["project_item_id"])) or str(n) == ref:
                return it
        raise LedgerError(f"no item {ref} on project #{self.number}")

    def _option_id(self, board, status):
        for o in board["status_options"]:
            name = o.get("name", {})
            name = name.get("raw") if isinstance(name, dict) else name
            if (name or "").lower() == status.lower():
                return o["id"]
        raise LedgerError(f"project #{self.number} has no Status option {status!r}")

    def show(self, ref):
        item = self._item(ref)
        n = (item.get("content") or {}).get("number")
        if n is None:
            return {"ref": ref, "title": item.get("title"), "status": item.get("status"), "body": "(draft)"}
        issue = json.loads(self._gh("issue", "view", str(n), "--repo", self.repo,
                                    "--json", "number,title,body,state,comments"))
        return {"ref": str(n), "title": issue["title"], "status": item.get("status"), "state": issue["state"],
                "body": issue["body"], "comments": [{"at": c["createdAt"], "text": c["body"]} for c in issue["comments"]]}

    def create(self, title, body, status):
        url = self._gh("issue", "create", "--repo", self.repo, "--title", title, "--body", body or " ").strip()
        n = url.rstrip("/").rsplit("/", 1)[-1]
        db_id = self._api(f"repos/{self.repo}/issues/{n}")["id"]
        added = self._api(f"{self.base}/items", "-X", "POST", "-f", "type=Issue", "-F", f"id={db_id}")
        board = self.board(force=True)[0]
        self._set_status(board, added["id"], status)
        return n

    def _set_status(self, board, item_id, status):
        self._api(f"{self.base}/items/{item_id}", "-X", "PATCH",
                  "-F", f"fields[][id]={board['status_field_id']}",
                  "-f", f"fields[][value]={self._option_id(board, status)}")
        # Writes refresh the cache before writing, so carry the new status into it, or every read
        # in the next minute (the per-turn brief among them) shows the old one.
        if self.cache.is_file():
            data = json.loads(self.cache.read_text())
            for it in data["items"]:
                if it["project_item_id"] == item_id:
                    it["status"] = status
            tmp = self.cache.with_suffix(".tmp")
            tmp.write_text(json.dumps(data))
            tmp.replace(self.cache)

    def _convert_draft(self, item):
        repo_id = json.loads(self._gh("repo", "view", self.repo, "--json", "id"))["id"]
        q = ("mutation($item:ID!,$repo:ID!){convertProjectV2DraftIssueItemToIssue("
             "input:{itemId:$item,repositoryId:$repo}){item{content{... on Issue{number}}}}}")
        out = json.loads(self._gh("api", "graphql", "-f", f"query={q}",
                                  "-f", f"item={item['node_id']}", "-f", f"repo={repo_id}"))
        return str(out["data"]["convertProjectV2DraftIssueItemToIssue"]["item"]["content"]["number"])

    def move(self, ref, status):
        board = self.board(force=True)[0]
        item = self._item(ref, board)
        if (item.get("content") or {}).get("number") is None and status == "In progress":
            ref = self._convert_draft(item)
        self._set_status(board, item["project_item_id"], status)
        return ref

    def comment(self, ref, text):
        self._gh("issue", "comment", str(ref).lstrip("#"), "--repo", self.repo, "--body", text)

    def close(self, ref):
        self.move(ref, "Done")
        self._gh("issue", "close", str(ref).lstrip("#"), "--repo", self.repo)
        self.closed_cache.unlink(missing_ok=True)

    def recently_closed(self):
        """The last 100 closed issues, however they were closed (a `Closes #n` commit too), with
        when and whether each is a milestone exit; cached like the board."""
        if self.closed_cache.is_file() and time.time() - self.closed_cache.stat().st_mtime < CACHE_SECONDS:
            return json.loads(self.closed_cache.read_text())
        rows = [{"ref": str(i["number"]), "title": i["title"], "closed_at": i["closed_at"],
                 "exit": bool(i.get("milestone")) and not i.get("parent_issue_url")}
                for i in self._api(f"repos/{self.repo}/issues?state=closed&sort=updated&direction=desc&per_page=100")
                if "pull_request" not in i and i.get("closed_at")]
        tmp = self.closed_cache.with_suffix(".tmp")
        tmp.write_text(json.dumps(rows))
        tmp.replace(self.closed_cache)
        return rows

    def status_of(self, ref):
        """An item's status straight from GitHub, or None when it is not on this project. Measured
        2026-09-24: the REST list endpoint can lag a write by minutes, while a direct lookup by
        issue number stayed fresh, so read-backs and commit gates ask this rather than the list."""
        ref = str(ref).lstrip("#")
        if ref.startswith("draft:"):
            board = self.board()[0]
            got = self._api(f"{self.base}/items/{ref[6:]}?fields[]={board['status_field_id']}")
            value = next((f.get("value") for f in got.get("fields", []) if f.get("name") == "Status"), None)
            return (value or {}).get("name", {}).get("raw")
        owner, name = self.repo.split("/", 1)
        q = ("query($owner:String!,$repo:String!,$number:Int!){repository(owner:$owner,name:$repo){"
             "issue(number:$number){projectItems(first:20){nodes{project{number} "
             "fieldValueByName(name:\"Status\"){... on ProjectV2ItemFieldSingleSelectValue{name}}}}}}}")
        try:
            out = json.loads(self._gh("api", "graphql", "-f", f"query={q}", "-f", f"owner={owner}",
                                      "-f", f"repo={name}", "-F", f"number={ref}", timeout=10))
        except LedgerError as e:
            if "Could not resolve to an Issue" in str(e):
                return None
            raise
        issue = ((out.get("data") or {}).get("repository") or {}).get("issue") or {}
        for node in (issue.get("projectItems") or {}).get("nodes", []):
            if node["project"]["number"] == self.number:
                return (node.get("fieldValueByName") or {}).get("name")
        return None

    # Milestones are the repository's own (REST /milestones); parents are GitHub sub-issues
    # (REST /issues/{n}/sub_issues), which take the child's database id, not its number.

    def _write(self, dry_run, path, *extra):
        if dry_run:
            print("dry-run: " + shlex.join(["gh", "api", path, *self.API, *extra]))
            return None
        return self._api(path, *extra)

    def _issue_number(self, ref, dry_run=False):
        """The issue number behind a ref, converting a draft card first (the draft convention)."""
        ref = str(ref).lstrip("#")
        if not ref.startswith("draft:"):
            return ref
        item = self._item(ref, self.board(force=True)[0])
        if dry_run:
            print(f"dry-run: convert {ref} to an issue in {self.repo} (convertProjectV2DraftIssueItemToIssue)")
            return ref
        return self._convert_draft(item)

    def _milestone_rows(self):
        return self._api(f"repos/{self.repo}/milestones?state=all&per_page=100", paginate=True)

    def _milestone_number(self, title):
        return next(m["number"] for m in self._milestone_rows() if m["title"] == title)

    def milestones(self):
        now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        rows = []
        for m in self._milestone_rows():
            due = m.get("due_on")
            if due and m["state"] == "open" and due < now:
                due = f"overdue since {due[:10]}"
            elif due:
                due = f"due {due[:10]}"
            rows.append({"title": m["title"], "state": m["state"], "open": m["open_issues"],
                         "closed": m["closed_issues"], "due": due, "number": m["number"]})
        return rows

    def create_milestone(self, title, description):
        args = ["-X", "POST", "-f", f"title={title}"] + (["-f", f"description={description}"] if description else [])
        self._api(f"repos/{self.repo}/milestones", *args)

    def set_milestone(self, ref, title):
        n = self._issue_number(ref)
        self._api(f"repos/{self.repo}/issues/{n}", "-X", "PATCH", "-F", f"milestone={self._milestone_number(title)}")
        return n

    def milestone_of(self, ref):
        return (self._api(f"repos/{self.repo}/issues/{str(ref).lstrip('#')}").get("milestone") or {}).get("title")

    def rename_milestone(self, old, new):
        self._api(f"repos/{self.repo}/milestones/{self._milestone_number(old)}", "-X", "PATCH", "-f", f"title={new}")

    def unplaced(self, refs):
        """The refs whose items have neither a milestone nor a parent. A draft card can carry
        neither, so it is always unplaced; an issue missing from the open list is skipped."""
        placed, listed = set(), set()
        for i in self._api(f"repos/{self.repo}/issues?state=open&per_page=100", paginate=True):
            if "pull_request" in i:
                continue
            listed.add(str(i["number"]))
            if i.get("milestone") or i.get("parent_issue_url"):
                placed.add(str(i["number"]))
        return [r for r in refs if r.startswith("draft:") or (r in listed and r not in placed)]

    def _db_id(self, n):
        return self._api(f"repos/{self.repo}/issues/{n}")["id"]

    def set_parent(self, child, parent, dry_run):
        child, parent = self._issue_number(child, dry_run), self._issue_number(parent, dry_run)
        child_id = "<id of " + child + ">" if child.startswith("draft:") else self._db_id(child)
        self._write(dry_run, f"repos/{self.repo}/issues/{parent}/sub_issues", "-X", "POST",
                    "-F", f"sub_issue_id={child_id}", "-F", "replace_parent=true")
        return child

    def unparent(self, child, dry_run):
        child = self._issue_number(child)
        parent = self.parent_of(child)
        if parent is None:
            raise LedgerError(f"#{child} has no parent")
        self._write(dry_run, f"repos/{self.repo}/issues/{parent}/sub_issue", "-X", "DELETE",
                    "-F", f"sub_issue_id={self._db_id(child)}")
        return child

    def parent_of(self, ref):
        try:
            return str(self._api(f"repos/{self.repo}/issues/{str(ref).lstrip('#')}/parent")["number"])
        except LedgerError as e:
            if "No parent issue found" in str(e):
                return None
            raise

    def outline(self, children):
        rows = self._milestone_rows()
        if not rows:  # projects without milestones pay one call, not two
            return []
        issues = [i for i in self._api(f"repos/{self.repo}/issues?milestone=*&state=all&per_page=100", paginate=True)
                  if "pull_request" not in i]
        node = lambda i: {"ref": str(i["number"]), "title": i["title"], "done": i["state"] == "closed"}
        result = []
        for m in sorted(rows, key=lambda m: m["number"]):
            exits = []
            for i in issues:
                if (i.get("milestone") or {}).get("number") == m["number"] and not i.get("parent_issue_url"):
                    summary = i.get("sub_issues_summary") or {}
                    kids = []
                    if children and summary.get("total"):
                        kids = [node(k) for k in self._api(f"repos/{self.repo}/issues/{i['number']}/sub_issues?per_page=100",
                                                           paginate=True)]
                    exits.append({**node(i), "child_done": summary.get("completed", 0),
                                  "child_total": summary.get("total", 0), "children": kids if children else None})
            exits.sort(key=lambda e: int(e["ref"]))
            result.append({"title": m["title"], "state": m["state"], "exits": exits})
        return result

    @staticmethod
    def init(root, args):
        if not (args.owner and args.project and args.repo):
            raise LedgerError("init github needs --owner, --project and --repo")
        config = {"backend": "github", "owner": args.owner, "project": int(args.project), "repo": args.repo}
        board = GitHubBackend(root, config).board(force=True)[0]
        names = {(o.get("name", {}).get("raw") if isinstance(o.get("name"), dict) else o.get("name") or "").lower()
                 for o in board["status_options"]}
        missing = [s for s in STATUSES if s.lower() not in names]
        if missing:
            raise LedgerError(f"project #{args.project} Status lacks options: {', '.join(missing)}")
        return config


BACKENDS = {"local": LocalBackend, "github": GitHubBackend}


def open_backend():
    root = project_root()
    if root is None:
        raise LedgerError("no .ledger/config.json in this project; run `ledger init`")
    config = json.loads((root / ".ledger" / "config.json").read_text())
    cls = BACKENDS.get(config.get("backend"))
    if cls is None:
        raise LedgerError(f"unknown backend {config.get('backend')!r}")
    b = cls(root, config)
    b.config = config
    return b


# ── workers: which agent holds which card ────────────────────────────────────────────────────
# One file per board, outside the repo, so every checkout of the same GitHub board shares it.
# A record is {card, session, pid, pid_start, stopped, settled}. A worker is live while it has not
# stopped and the Claude process that started it still runs; a record that is not live and not
# settled is a card waiting on the Lead's decision, and any board write to that card settles it.

BOARD_LINE = re.compile(r"^\s*Board:\s*(?:#(\d+)|(none))\b", re.I | re.M)


def workers_path(b):
    key = (f"github-{b.owner}-{b.number}" if isinstance(b, GitHubBackend)
           else hashlib.sha1(str(b.path.parent.parent).encode()).hexdigest()[:12])
    return private_dir() / f"workers-{key}.json"


class Workers:
    """The worker records, locked for a read-modify-write: hooks for parallel workers run at once."""

    def __init__(self, b):
        self.path = workers_path(b)

    def __enter__(self):
        self.lock = open(self.path.with_suffix(".lock"), "w")
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        self.records = json.loads(self.path.read_text()) if self.path.is_file() else {}
        return self.records

    def __exit__(self, *exc):
        if exc[0] is None:
            tmp = self.path.with_suffix(".tmp")
            tmp.write_text(json.dumps(self.records, indent=1))
            tmp.replace(self.path)
        self.lock.close()


def claude_process():
    """The pid and start time of the Claude Code process this hook runs under, or (None, None)."""
    pid = os.getppid()
    while pid > 1:
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            return None, None
        name, rest = stat[stat.index("(") + 1:stat.rindex(")")], stat[stat.rindex(")") + 2:].split()
        if name == "claude":
            return pid, rest[19]
        pid = int(rest[1])
    return None, None


def is_live(r):
    if r["stopped"]:
        return False
    if r["pid"] is None:
        return True
    try:
        stat = Path(f"/proc/{r['pid']}/stat").read_text()
    except OSError:
        return False
    return stat[stat.rindex(")") + 2:].split()[19] == r["pid_start"]


def settle(b, ref):
    """A board write to a card is the Lead's decision on it: its stopped workers need no more."""
    ref = str(ref).lstrip("#")
    with Workers(b) as records:
        for r in records.values():
            if r["card"] == ref and not is_live(r):
                r["settled"] = True


def record_worker(b, card, agent, session, stopped=None):
    """Record a worker against a card; a new worker is the decision on the card's stopped ones."""
    pid, start = claude_process()
    with Workers(b) as records:
        for r in records.values():
            if r["card"] == card and not is_live(r):
                r["settled"] = True
        records[agent] = {"card": card, "session": session, "pid": pid, "pid_start": start,
                          "stopped": stopped, "settled": False}


def worker_state(b, items):
    """The open cards whose worker stopped and await a decision, each with the sessions that
    dispatched it, and the In progress cards with no live worker. Drops records of Done cards,
    which need nothing more."""
    status = {it["ref"]: (it["status"] or "").lower() for it in items}
    with Workers(b) as records:
        for agent in [a for a, r in records.items() if status.get(r["card"]) == "done"]:
            del records[agent]
        live = {r["card"] for r in records.values() if is_live(r)}
        waiting = {}
        for r in records.values():
            if not r["settled"] and r["card"] not in live and status.get(r["card"]) in OPEN_ORDER:
                waiting.setdefault(r["card"], set()).add(r["session"])
    idle = [ref for ref, s in status.items() if s == "in progress" and ref not in live and ref not in waiting]
    return dict(sorted(waiting.items(), key=lambda kv: int(kv[0]))), idle


def worker_lines(b, items):
    waiting, idle = worker_state(b, items)
    lines = []
    if waiting:
        lines.append("Waiting on a decision (worker stopped): " + ", ".join(f"#{r}" for r in waiting)
                     + ". Move, comment on or close each.")
    if idle:
        lines.append("In progress with no live worker: " + ", ".join(r if r.startswith("draft:") else f"#{r}" for r in idle)
                     + ". Dispatch, move or close each.")
    return lines


# ── board audit: a card titled `Board audit: …`, due after enough closes or a finished exit ─────

AUDIT = "Board audit"


def audit_line(b, items):
    """`Board audit due (<reason>): …` while an audit is due and none is In progress, else None.
    Due once `audit_every_closes` items (default 10), or any milestone exit, closed after the last
    audit card did; computed from the board, so a `Closes #n` commit counts like `ledger close`."""
    audits = [it for it in open_items(items) if it["title"].startswith(AUDIT)]
    if any(it["status"].lower() == "in progress" for it in audits):
        return None
    closed = b.recently_closed()
    last = max((c["closed_at"] for c in closed if c["title"].startswith(AUDIT)), default="")
    since = [c for c in closed if c["closed_at"] > last and not c["title"].startswith(AUDIT)]
    exits = [f"#{c['ref']}" for c in since if c["exit"]]
    if exits:
        more = f" +{len(exits) - 3} more" if len(exits) > 3 else ""
        reason = f"exit {', '.join(exits[:3])}{more} closed"
    elif len(since) >= int(b.config.get("audit_every_closes", 10)):
        reason = f"{len(since)} items closed since the last audit"
    else:
        return None
    todo = (f"dispatch a scout for #{audits[0]['ref']}" if audits
            else f"create a `{AUDIT}: <date>` card and dispatch a scout for it")
    return f"{AUDIT} due ({reason}): {todo} (task-ledger skill, Board audit)."


# ── commands ─────────────────────────────────────────────────────────────────────────────────

def line(it):
    ref = f"#{it['ref']}" if not it["ref"].startswith("draft:") else it["ref"]
    return f"{ref} [{it['status']}] {it['title']}"


def open_items(items):
    rows = [it for it in items if (it["status"] or "").lower() in OPEN_ORDER]
    return sorted(rows, key=lambda it: OPEN_ORDER[it["status"].lower()])


def cmd_list(b, a):
    items = b.items()
    rows = items if a.all else open_items(items)
    if a.json:
        print(json.dumps(rows, indent=2))
        return
    for it in rows[:a.limit]:
        print(line(it))
    if len(rows) > a.limit:
        print(f"...and {len(rows) - a.limit} more")


def cmd_show(b, a):
    print(json.dumps(b.show(a.ref), indent=2))


def read_back(b, ref):
    """The status after a write. A failed read-back must not look like a failed write, or the
    caller retries it and, for create, makes a duplicate."""
    try:
        return b.status_of(ref)
    except LedgerError as e:
        return f"written, status unconfirmed: {e}"


def cmd_create(b, a):
    ref = b.create(a.title, a.body or "", canonical_status(a.status))
    print(f"#{ref} [{read_back(b, ref)}] {a.title}")


def cmd_move(b, a):
    ref = b.move(a.ref, canonical_status(a.status))
    settle(b, ref)
    print(f"#{str(ref).lstrip('#')} now {read_back(b, ref)}")


def cmd_comment(b, a):
    b.comment(a.ref, a.text)
    settle(b, a.ref)
    print(f"commented on #{a.ref.lstrip('#')}")


def cmd_close(b, a):
    if a.text:
        b.comment(a.ref, a.text)
    b.close(a.ref)
    settle(b, a.ref)
    print(f"#{a.ref.lstrip('#')} now {read_back(b, a.ref)}")
    try:
        goal = completed_goal(b, a.ref.lstrip("#"))
    except LedgerError as e:
        print(f"goal check skipped: {e}")
        return
    if goal:
        print(f"Goal complete: {goal}. Reconcile before the next goal (lead-playbook, Goals and Roadmap).")


def completed_goal(b, ref):
    """The title of the goal this close completed, or None. The closed item counts as done
    whatever the list says, because a GitHub list can lag the write."""
    title = b.milestone_of(ref)
    if not title:
        parent = b.parent_of(ref)
        title = b.milestone_of(parent) if parent else None
    m = next((m for m in b.outline(children=False) if m["title"] == title), None) if title else None
    if not m or not m["exits"]:
        return None
    return title if all(e["done"] or e["ref"] == ref for e in m["exits"]) else None


def cmd_status(b, a):
    """For commit gates: the item's current status, or nothing when it is not on the board.
    Exit 0 when answered, 2 when the lookup itself failed."""
    try:
        status = b.status_of(a.ref)
    except LedgerError as e:
        if isinstance(b, LocalBackend):
            return 0
        print(f"ledger: {e}", file=sys.stderr)
        return 2
    except (subprocess.TimeoutExpired, ValueError):
        return 2
    if status:
        print(status)
    return 0


def cmd_board_json(b, a):
    """The raw GitHub board for commit gates: exit 0 fresh, 3 stale but usable, 1 nothing."""
    if not isinstance(b, GitHubBackend):
        print(json.dumps({"items": [{"status": it["status"], "content": {"number": it["number"], "title": it["title"]},
                                     "title": it["title"]} for it in b.items()]}))
        return 0
    data, fresh = b.board(force=a.force)
    print(json.dumps(data))
    return 0 if fresh else 3


def cmd_brief(b, a):
    """For hooks. Full brief at session start, resume and compaction; on each prompt only what
    changed since the last brief this session, and nothing when nothing did."""
    items = b.items()
    rows = [it for it in items if (it["status"] or "").lower() in BRIEF_STATUSES]
    rows.sort(key=lambda it: OPEN_ORDER[it["status"].lower()])
    snapshot = {it["ref"]: f"{it['status']}|{it['title']}" for it in rows}
    session = hook_input().get("session_id") or "nosession"
    state = private_dir() / f"brief-{hashlib.sha1(str(project_root()).encode()).hexdigest()[:12]}-{session}.json"
    previous = json.loads(state.read_text()) if a.changes and state.is_file() else None
    state.write_text(json.dumps(snapshot))
    if previous is None:
        for l in full_brief(b, rows):
            print(l)
    else:
        changed = [line(it) for it in rows if previous.get(it["ref"]) != snapshot[it["ref"]]]
        gone = [ref for ref in previous if ref not in snapshot]
        if changed or gone:
            print("Board changes since the last brief:")
            for l in changed:
                print(l)
            for ref in gone:
                print(f"#{ref} left the open columns")
    for l in worker_lines(b, items) + [audit_line(b, items) or ""]:  # every brief, until dealt with
        if l:
            print(l)


def resolve_milestone(b, name):
    """A milestone title from its exact title or a unique prefix of it, e.g. `M3`."""
    titles = [m["title"] for m in b.milestones()]
    if name in titles:
        return name
    hits = [t for t in titles if t.lower().startswith(name.lower())]
    if len(hits) == 1:
        return hits[0]
    raise LedgerError(f"no milestone {name!r}" if not hits else f"{name!r} matches several: {'; '.join(hits)}")


def short_name(title):
    return title.split()[0] if title.split() else title


def roadmap_order(milestones):
    """The roadmap is the milestones ordered by their `M<n>` title prefix; renaming re-orders it.
    Milestones without the prefix follow, in the backend's order."""
    def key(m):
        name = short_name(m["title"])
        return (0, int(name[1:])) if name[:1] in "Mm" and name[1:].isdigit() else (1, 0)
    return sorted(milestones, key=key)


def exits_done(m):
    return sum(e["done"] for e in m["exits"]), len(m["exits"])


def cmd_milestone(b, a):
    if a.mcmd == "list":
        for m in b.milestones():
            print(f"{m['title']}  [{m['state']}] {m['open']} open / {m['closed']} closed, {m['due'] or 'no due date'}")
    elif a.mcmd == "create":
        b.create_milestone(a.title, a.description or "")
        m = next((m for m in b.milestones() if m["title"] == a.title), None)
        print(f"milestone {a.title!r} [{m['state']}]" if m else f"milestone {a.title!r} written, not yet listed")
    elif a.mcmd == "rename":
        old = resolve_milestone(b, a.milestone)
        b.rename_milestone(old, a.title)
        listed = any(m["title"] == a.title for m in b.milestones())
        print(f"milestone {old!r} now {a.title!r}" if listed else f"milestone {a.title!r} written, not yet listed")
    elif a.mcmd == "set":
        ref = b.set_milestone(a.ref, resolve_milestone(b, a.milestone))
        try:
            got = b.milestone_of(ref)
        except LedgerError as e:
            got = f"written, unconfirmed: {e}"
        print(f"#{str(ref).lstrip('#')} milestone: {got}")


def cmd_parent(b, a):
    ref = b.set_parent(a.child, a.parent, a.dry_run)
    if not a.dry_run:
        print(f"#{str(ref).lstrip('#')} parent: #{b.parent_of(ref)}")


def cmd_unparent(b, a):
    ref = b.unparent(a.child, a.dry_run)
    if not a.dry_run:
        print(f"#{str(ref).lstrip('#')} parent: {b.parent_of(ref) or 'none'}")


def cmd_progress(b, a):
    """Milestone, its exits, their tasks; every count is computed from item states."""
    tree = roadmap_order(b.outline(children=True))
    if a.milestone:
        title = resolve_milestone(b, a.milestone)
        tree = [m for m in tree if m["title"] == title]
    else:
        tree = [m for m in tree if m["state"] == "open"]
    if a.json:
        print(json.dumps(tree, indent=2))
        return
    mark = lambda done: "[x]" if done else "[ ]"
    for m in tree:
        done, total = exits_done(m)
        tasks = sum(e["child_done"] for e in m["exits"]), sum(e["child_total"] for e in m["exits"])
        print(f"{m['title']}  exits {done}/{total} · tasks {tasks[0]}/{tasks[1]}")
        for e in m["exits"]:
            print(f"  {mark(e['done'])} #{e['ref']} {e['title']}  {e['child_done']}/{e['child_total']}")
            for k in e["children"]:
                print(f"      {mark(k['done'])} #{k['ref']} {k['title']}")


def full_brief(b, rows):
    """The session-start brief, sized by the current goal rather than the board, most important
    first: the roadmap and the current goal's open exits, then work in progress anywhere, then
    counts of what is left out. A board without goals is briefed as its open work."""
    try:
        lines, shown = goal_brief(b)
    except Exception as e:
        lines, shown = [f"Goals unreadable: {str(e)[:150]}"], set()
    status = lambda s: [it for it in rows if it["status"].lower() == s and it["ref"] not in shown]
    blocked = len(status("blocked"))
    if lines:
        working = status("in progress")
        if working:
            lines += ["Also in progress:"] + [f"  {line(it)}" for it in working]
        hidden = [f"{n} {s}" for n, s in ((len(status("next")), "Next"), (blocked, "Blocked")) if n]
        if hidden:
            lines.append(f"Not shown: {', '.join(hidden)} (`ledger list --limit 100` shows them)")
    elif rows:
        lines = ["Board (open items):"] + [line(it) for it in status("in progress") + status("next")]
        if blocked:
            lines.append(f"+{blocked} Blocked (`ledger list --limit 100` shows them)")
    return lines + [RECONCILE] if lines else []


def goal_brief(b):
    """The roadmap line, the current goal (the first in roadmap order not yet complete) with its
    open exits, and the open items under no goal; nothing when the project has no open goals.
    Also the refs it listed, so the rest of the brief does not repeat them."""
    tree = [m for m in roadmap_order(b.outline(children=False)) if m["state"] == "open"]
    if not tree:
        return [], set()
    items = {it["ref"]: it for it in b.items()}
    current = next((m for m in tree if not m["exits"] or exits_done(m)[0] < len(m["exits"])), None)
    parts = [f"{'▶ ' if m is current else ''}{short_name(m['title'])} {'/'.join(map(str, exits_done(m)))} exits"
             for m in tree]
    lines, shown = [f"Milestones: {' · '.join(parts)}"], set()
    if current:
        lines.append(f"Current goal: {current['title']}")
        for e in current["exits"]:
            if not e["done"]:
                it = items.get(e["ref"], {"ref": e["ref"], "status": "not on the board", "title": e["title"]})
                lines.append(f"  {line(it)}")
                shown.add(e["ref"])
    else:
        lines.append("No current goal: every open milestone is complete. Reconcile, then shape the next goal.")
    unplaced = b.unplaced([it["ref"] for it in open_items(items.values()) if not it["title"].startswith(AUDIT)])
    if unplaced:
        listed = ", ".join(r if r.startswith("draft:") else f"#{r}" for r in unplaced[:10])
        more = f" +{len(unplaced) - 10} more" if len(unplaced) > 10 else ""
        lines.append(f"Unplaced: {listed}{more}. Every open item belongs to a goal: attach it, propose a goal, or ask.")
    return lines, shown


def cmd_claim(b, a):
    """Record a running worker against a card, for a worker the dispatch hook did not record.
    A mistyped id would mark the card live until the session ends, so the id must be a worker's."""
    card = a.ref.lstrip("#")
    if not list((Path.home() / ".claude" / "projects").glob(f"*/*/subagents/agent-{a.worker}.jsonl")):
        raise LedgerError(f"no worker {a.worker}: use the agentId its launch returned")
    record_worker(b, card, a.worker, os.environ.get("CLAUDE_CODE_SESSION_ID"))
    print(f"#{card}: worker {a.worker} recorded against it")


def hook_input():
    # A hook writes its input at once and closes stdin; a background shell may hold stdin open
    # forever, so wait briefly rather than block on it.
    try:
        waiting = not sys.stdin.isatty() and select.select([sys.stdin], [], [], 1)[0]
        return json.loads(sys.stdin.read() or "{}") if waiting else {}
    except ValueError:
        return {}


def cmd_hook(b, hook):
    """The worker hooks: tie each Agent dispatch to its card, and each worker stop to a decision."""
    event, tool = hook.get("hook_event_name"), hook.get("tool_name")
    prompt = (hook.get("tool_input") or {}).get("prompt") or ""
    named = BOARD_LINE.search(prompt)

    if event == "PreToolUse" and tool == "Agent" and not named:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse", "permissionDecision": "deny",
            "permissionDecisionReason": "Name the card this worker serves: add a line `Board: #<n>` to the prompt, "
                                        "or `Board: none` for work outside the board (task-ledger skill, Workers)."}}))

    elif event == "PostToolUse" and tool == "Agent" and named and named.group(1):
        card, response = named.group(1), hook.get("tool_response") or {}
        if not response.get("agentId"):
            return
        record_worker(b, card, response["agentId"], hook.get("session_id"),
                      stopped=None if response.get("status") == "async_launched" else time.time())
        try:
            status = b.status_of(card)
            if (status or "").lower() not in ("in progress", "done"):
                b.move(card, "In progress")
                status = read_back(b, card)
            note = f"Board: #{card} is {status}; this worker is recorded against it."
        except Exception as e:
            note = f"Board: worker recorded against #{card}, but its status could not be set ({str(e)[:150]}); move it yourself."
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": note}}))

    elif event in ("SubagentStart", "SubagentStop"):
        with Workers(b) as records:
            r = records.get(hook.get("agent_id"))
            if r is None:
                return
            if event == "SubagentStop":
                r["stopped"] = time.time()
            else:  # resumed, possibly under a new Claude process
                r["pid"], r["pid_start"] = claude_process()
                r.update(stopped=None, settled=False, session=hook.get("session_id"))

    elif event == "Stop" and not hook.get("stop_hook_active"):
        # Only this session's cards: another session's Lead decides on the workers it dispatched.
        # The audit is the board's, so it blocks every session until one dispatches it.
        session, items = hook.get("session_id"), b.items()
        cards = [c for c, sessions in worker_state(b, items)[0].items() if session in sessions]
        reasons = [audit_line(b, items)] + (["; ".join(f"#{c}: its worker stopped" for c in cards)
                                            + ". Move, comment on or close each first."] if cards else [])
        if any(reasons):
            print(json.dumps({"decision": "block", "reason": " ".join(r for r in reasons if r)}))


def cmd_init(a):
    root = Path(os.environ.get("CLAUDE_PROJECT_DIR") or Path.cwd())
    (root / ".ledger").mkdir(exist_ok=True)
    config = BACKENDS[a.backend].init(root, a)
    (root / ".ledger" / "config.json").write_text(json.dumps(config, indent=2) + "\n")
    print(f"ledger: {a.backend} backend configured in {root / '.ledger' / 'config.json'}")


def main():
    p = argparse.ArgumentParser(prog="ledger", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("list"); s.add_argument("--all", action="store_true"); s.add_argument("--json", action="store_true")
    s.add_argument("--limit", type=int, default=20)
    s = sub.add_parser("show"); s.add_argument("ref")
    s = sub.add_parser("create"); s.add_argument("--title", required=True); s.add_argument("--body")
    s.add_argument("--status", default="Backlog")
    s = sub.add_parser("move"); s.add_argument("ref"); s.add_argument("status")
    s = sub.add_parser("comment"); s.add_argument("ref"); s.add_argument("--text", required=True)
    s = sub.add_parser("close"); s.add_argument("ref"); s.add_argument("--text")
    s = sub.add_parser("brief"); s.add_argument("--changes", action="store_true")
    sub.add_parser("hook")
    s = sub.add_parser("claim"); s.add_argument("ref"); s.add_argument("worker")
    s = sub.add_parser("status"); s.add_argument("ref")
    s = sub.add_parser("board-json"); s.add_argument("--force", action="store_true")
    s = sub.add_parser("milestone"); ms = s.add_subparsers(dest="mcmd", required=True)
    ms.add_parser("list")
    m = ms.add_parser("create"); m.add_argument("--title", required=True); m.add_argument("--description")
    m = ms.add_parser("set"); m.add_argument("ref"); m.add_argument("milestone")
    m = ms.add_parser("rename"); m.add_argument("milestone"); m.add_argument("--title", required=True)
    s = sub.add_parser("parent"); s.add_argument("child"); s.add_argument("parent"); s.add_argument("--dry-run", action="store_true")
    s = sub.add_parser("unparent"); s.add_argument("child"); s.add_argument("--dry-run", action="store_true")
    s = sub.add_parser("progress"); s.add_argument("milestone", nargs="?"); s.add_argument("--json", action="store_true")
    s = sub.add_parser("init"); s.add_argument("backend", choices=sorted(BACKENDS))
    s.add_argument("--owner"); s.add_argument("--project"); s.add_argument("--repo")
    a = p.parse_args()

    if a.cmd in ("brief", "hook"):  # a hook must never fail the turn
        try:
            if a.cmd == "brief":
                cmd_brief(open_backend(), a)
            elif project_root():  # a project without a board dispatches freely
                cmd_hook(open_backend(), hook_input())
        except Exception:
            pass
        return 0
    try:
        if a.cmd == "init":
            cmd_init(a)
            return 0
        rc = globals()[f"cmd_{a.cmd.replace('-', '_')}"](open_backend(), a)
        return rc or 0
    except LedgerError as e:
        print(f"ledger: {e}", file=sys.stderr)
        return 1
    except subprocess.TimeoutExpired:
        print("ledger: GitHub did not answer in time", file=sys.stderr)
        return 1


